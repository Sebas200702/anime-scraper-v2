{
  "name": "anime-scraper-v2",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "keywords": [
    "anime",
    "scraper",
    "jikan"
  ],
  "scripts": {
    "build": "tsc --project tsconfig.json && tsc-alias --project tsconfig.json ",
    "start": "bun dist/src/index.js",
    "dev": "bun src/index.ts",
    "serve": "bun src/server.ts",
    "incremental": "bun src/scripts/incremental.ts",
    "incremental:hot": "bun src/scripts/incremental.ts --drain --group=hot",
    "incremental:slow": "bun src/scripts/incremental.ts --drain --group=slow",
    "incremental:discover": "bun src/scripts/incremental.ts --discover",
    "incremental:normalize": "bun src/scripts/normalizeRefresh.ts",
    "db:ingest-schema": "bun src/scripts/ingestSchema.ts",
    "db:seed-task-history": "bun src/scripts/seedTaskHistory.ts",
    "db:seed-producer-pages": "bun src/scripts/seedProducerPages.ts",
    "test": "bun test",
    "proxies:probe": "bun src/scripts/probeProxies.ts",
    "test:integration": "RUN_DB_TESTS=1 bun test tests/queue.integration.test.ts tests/promotion.integration.test.ts tests/fkFilter.integration.test.ts tests/incremental.integration.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed-policy": "bun src/scripts/seedTaskPolicy.ts",
    "db:seed-dump": "bun src/scripts/seedAnimeFromDump.ts",
    "backfill": "bun src/scripts/backfillAll.ts",
    "schema:mirror": "bun scripts/mirrorSchema.ts",
    "schema:check": "bun scripts/mirrorSchema.ts --check",
    "promote": "bun src/scripts/promote.ts",
    "taxonomy:build": "bun src/scripts/buildMalTaxonomyMap.ts",
    "taxonomy:reclassify": "bun src/scripts/reclassifyMalTaxonomy.ts",
    "taxonomy:cleanup": "bun src/scripts/cleanupMisclassifiedGenres.ts",
    "kitsu:crossmap": "bun src/scripts/buildKitsuCrossmap.ts",
    "ann:seed-ids": "bun src/scripts/seedAnnIds.ts",
    "artists:match-staff": "bun src/scripts/matchArtistsToStaff.ts",
    "artists:merge-duplicates": "bun src/scripts/mergeDuplicateArtists.ts",
    "tvdb:seed-ids": "bun src/scripts/seedTvdbIds.ts",
    "tvdb:fix-duplicates": "bun src/scripts/fixTvdbDuplicates.ts",
    "kitsu:fix-duplicates": "bun src/scripts/fixKitsuDuplicates.ts",
    "tmdb:seed-ids": "bun src/scripts/seedTmdbIds.ts",
    "anilist:seed-ids": "bun src/scripts/seedAnilistIds.ts",
    "anilist:enumerate": "bun src/scripts/enumerateAnilist.ts",
    "malManga:seed-tasks": "bun src/scripts/initializeMalMangaTasks.ts",
    "malCharacters:seed-tasks": "bun src/scripts/initializeMalCharactersTasks.ts",
    "malPerson:seed-tasks": "bun src/scripts/initializeMalPersonTasks.ts",
    "anilistMedia:seed-tasks": "bun src/scripts/initializeAnilistMediaTasks.ts",
    "musicMeta:seed-tasks": "bun src/scripts/initializeMusicMetaTasks.ts",
    "episodes:fill-from-mal": "bun src/scripts/fillEpisodesFromMal.ts",
    "music:fix-urls": "bun src/scripts/fixAnimeThemesUrls.ts",
    "mappings:repair": "bun src/scripts/repairAnimeMappings.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15",
    "cheerio": "^1.2.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "pg": "^8.23.1",
    "tsx": "^4.21.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/bun": "latest",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.5.3",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "typescript": "^5"
  }
}
