# anime-scraper-v2 — variables de entorno
# Copia este archivo a `.env` y completa los valores.

# Postgres de ingesta: cola `ingest.*` + catálogo (el mismo motor que prod).
# Local por defecto: `postgres://anidev:anidev@127.0.0.1:5432/scraper_local`
DATABASE_URL=

# Lease del claim en segundos: si el proceso muere, el reaper devuelve la tarea
# a `pending` cuando vence (default 900).
TASK_LEASE_SECONDS=

# Timeout por intento de fetch en ms (default 30000).
FETCH_TIMEOUT_MS=

# Fuentes
JIKAN_BASE=https://api.jikan.moe/v4
TVDB_API_KEY=
TVDB_BASE=https://api4.thetvdb.com/v4
ANIME_THEMES_BASE=https://animethemes.moe/_next/data/VWF_eO0-IV7PSTArS1q1e
KITSU_BASE=https://kitsu.io/api/edge
ANILIST_BASE=https://graphql.anilist.co

# Credenciales para proxies que exigen autenticación (responden 407 sin ellas).
PROXY_USER=
PROXY_PASS=
