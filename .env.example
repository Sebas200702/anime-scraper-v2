# anime-scraper-v2 — variables de entorno
# Copia este archivo a `.env` y completa los valores.

# Postgres de ingesta: cola `ingest.*` + catálogo (el mismo motor que prod).
# Local por defecto: `postgres://anidev:anidev@127.0.0.1:5432/scraper_local`
DATABASE_URL=

# Lease del claim en segundos: si el proceso muere, el reaper devuelve la tarea
# a `pending` cuando vence (default 900).
TASK_LEASE_SECONDS=

# Timeout por intento de fetch en ms (default 8000).
FETCH_TIMEOUT_MS=

# Fuentes
JIKAN_BASE=https://api.jikan.moe/v4
TVDB_API_KEY=
TVDB_BASE=https://api4.thetvdb.com/v4
ANIME_THEMES_BASE=https://animethemes.moe
# Opcional: fija el buildId de Next (por defecto se resuelve solo del sitio).
ANIME_THEMES_BUILD_ID=
KITSU_BASE=https://kitsu.io/api/edge
ANILIST_BASE=https://graphql.anilist.co

# MAL API oficial v2: idioma/estudios/géneros/stats con ids MAL nativos.
# Client id GRATIS en https://myanimelist.net/apiconfig (crear app → client id).
# Sin esto la fuente `mal` queda en `skipped` (no rompe el resto del backfill).
MAL_CLIENT_ID=
MAL_API_BASE=https://api.myanimelist.net/v2
# Web de MAL (HTML) para personajes/seiyuus/staff (la API no los expone).
MAL_WEB_BASE=https://myanimelist.net

# Credenciales para proxies que exigen autenticación (responden 407 sin ellas).
PROXY_USER=
PROXY_PASS=

# Modo de corrida: `backfill` activa 30 tareas en vuelo por fuente (una IP por
# tarea) con la cuota por (host, IP). Sin esta variable rigen los valores
# conservadores de la Fase 0.
SCRAPER_MODE=

# Tope opcional de tareas en vuelo (default: el del perfil backfill = 30).
# Trial de ProxyScrape: solo 10 conexiones concurrentes → SCRAPER_MAX_WORKERS=10
# hasta tener un pool sin ese tope. Nunca recomendar proxies de pago: el
# one-shot se hace con el trial o con IP directa y rate-limit honesto.
SCRAPER_MAX_WORKERS=

# Origen/destino de la promoción Modo A → prod (nunca la misma DB).
PROMOTE_FROM_URL=
PROMOTE_TO_URL=

# Dónde están los schemas dueños del DDL (default: ../anidev-v2/src/lib/db/schemas).
ANIDEV_SCHEMAS_DIR=
